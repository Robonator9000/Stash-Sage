generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id               String   @id @default(cuid())
  name             String
  strain           String   @default("")
  type             String   @default("hybrid")
  thc              Float    @default(0)
  cbd              Float    @default(0)
  amount           Float    @default(0)
  price            Float    @default(0)
  picture          String?
  notes            String?
  rating           Float    @default(0)
  brand            String?
  consumptionCount Int      @default(0)
  lastConsumed     DateTime?
  favorite         Boolean  @default(false)
  tags             String   @default("")
  effects          String   @default("")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  sessions         Session[]
  consumptionLogs  ConsumptionLog[]
}

model Session {
  id              String   @id @default(cuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  amount          Float    @default(0)
  people          Int      @default(1)
  hitsCount       Int      @default(0)
  notes           String?
  bowlsPerPerson  Float    @default(0)
  personHits      String   @default("")
  rotationEnabled Boolean  @default(false)
  date            DateTime @default(now())
  createdAt       DateTime @default(now())

  consumptionLogs ConsumptionLog[]
}

model ConsumptionLog {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sessionId   String?
  session     Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  amount      Float
  consumedAt  DateTime @default(now())
  type        String   @default("consume")
  note        String?
  createdAt   DateTime @default(now())
}

model ActivityLog {
  id         String   @id @default(cuid())
  type       String   // "product_created", "product_updated", "product_deleted", "consumed", "sold", "session_completed", "favorite_toggled"
  entityId   String   // product ID or session ID
  entityType String   // "product" or "session"
  details    String   @default("{}") // JSON string with change details
  productName String  @default("") // denormalized for quick display even if product is deleted
  createdAt  DateTime @default(now())
}

model AppSettings {
  id                String  @id @default("app")
  language          String  @default("en")
  theme             String  @default("dark")
  onboardingDone    Boolean @default(false)
  currency          String  @default("$")
  decimalPrecision  Int     @default(2)
  showTimerMs       Boolean @default(false)
  pinEnabled        Boolean @default(false)
  pinHash           String  @default("")
  lowStockThreshold Float   @default(3)
  statsVisibility   String  @default("{\"totalProducts\":true,\"totalAmount\":true,\"totalSessions\":true,\"averageRating\":true,\"averageTHC\":true,\"totalValue\":true,\"lastConsumed\":true}")
  sessionDefaults   String  @default("{\"defaultAmount\":0.5,\"defaultPeople\":2,\"defaultHitTimer\":10,\"defaultGramsPerBowl\":0.25,\"rotationEnabled\":false}")
  favoriteBrands    String  @default("[]")
  recentBrands      String  @default("[]")
  budgetLimit       Float   @default(0)
  budgetPeriod      String  @default("monthly")
}
